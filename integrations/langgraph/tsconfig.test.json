{
  // Typecheck-only pass over the tests and examples. The build tsconfig deliberately
  // keeps `include: ["src"]` so `dist/` holds the shipped surface and nothing else —
  // which also meant `pnpm typecheck` never looked at `test/`, so a test-only type
  // error could slip past both scripts. `pnpm typecheck` runs this too.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    // The build config pins `rootDir` to `src` so `dist/` stays flat. Nothing is
    // emitted here, so widen it to the package root to admit `test/` and `examples/`.
    "rootDir": ".",
    // The examples import the package by its published name, so they stay
    // copy-pasteable. This points that name at the local source so they are
    // type-checked against the code in this folder rather than a stale `dist/`.
    // (No `baseUrl` — TypeScript 7 removed it; paths resolve relative to this file.)
    "paths": { "@cortadel/langgraph": ["./src/index.ts"] }
  },
  "include": ["src", "test", "examples"]
}
