  },
  "devDependencies": {
    "@langchain/core": "^1.2.7",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
