{
  "name": "@cortadel/langgraph",
  "version": "0.1.0",
  "description": "Cortadel long-term memory for LangGraph — a BaseStore implementation, memory tools, and automatic recall/persist graph nodes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "homepage": "https://cortadel.ai",
  "bugs": { "url": "https://github.com/cortadel/cortadel/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortadel/cortadel.git",
    "directory": "integrations/langgraph"
  },
  "keywords": ["langgraph", "langchain", "cortadel", "ai", "memory", "agents", "knowledge-graph", "llm", "rag"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
