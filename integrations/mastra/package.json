{
  "name": "@cortadel/mastra",
  "version": "0.1.0",
  "description": "Cortadel memory for Mastra agents — long-term temporal graph memory as Mastra tools plus an automatic recall/persist processor.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "homepage": "https://cortadel.ai",
  "bugs": {
    "url": "https://github.com/cortadel/cortadel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortadel/cortadel.git",
    "directory": "integrations/mastra"
  },
  "keywords": [
    "ai",
    "memory",
    "agents",
    "mastra",
    "knowledge-graph",
    "llm",
    "rag",
    "cortadel"
