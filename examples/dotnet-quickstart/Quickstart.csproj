<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Cortadel.Quickstart</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local project reference for running from a repo clone.
         In your own app, replace this with: <PackageReference Include="Cortadel.Sdk" Version="0.1.0" /> -->
    <ProjectReference Include="..\..\sdk\dotnet\Cortadel.Sdk\Cortadel.Sdk.csproj" />
  </ItemGroup>

</Project>
